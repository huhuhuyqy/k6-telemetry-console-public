{
  "name": "k6-telemetry-console",
  "version": "0.2.8",
  "description": "Standalone Electron window for the Flydigi K6 telemetry light controller",
  "main": "main.js",
  "private": true,
  "author": "K6 Telemetry Demo",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "setup:bridge": "powershell -ExecutionPolicy Bypass -File scripts/setup-bridge.ps1",
    "build:bridge": "powershell -ExecutionPolicy Bypass -File scripts/build-bridge.ps1",
    "test:python": "powershell -ExecutionPolicy Bypass -File scripts/test-python.ps1",
    "test:js": "node --test tests/runtime-core.test.mjs tests/bridge-health.test.cjs",
    "test": "pnpm run test:python && pnpm run test:js",
    "sync:browser": "powershell -ExecutionPolicy Bypass -File scripts/sync-browser.ps1",
    "check:browser": "powershell -ExecutionPolicy Bypass -File scripts/sync-browser.ps1 -Check",
    "dist:portable": "pnpm run build:bridge && electron-builder --win portable",
    "dist": "pnpm run build:bridge && electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.k6.telemetry.console",
    "productName": "K6 Telemetry Console",
    "artifactName": "K6-Telemetry-Console-${version}-${arch}.${ext}",
    "asar": false,
    "files": [
      "main.js",
      "bridge-health.cjs",
      "index.html",
      "app.js",
      "runtime-core.mjs",
      "style.css",
      "LICENSE",
      "package.json",
      "bridge/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
